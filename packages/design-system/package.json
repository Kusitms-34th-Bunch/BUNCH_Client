{
  "name": "@app/design-system",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:index": "tsx scripts/genIndex.ts",
    "gen:index:check": "tsx scripts/genIndex.ts --check",
    "icons:build": "node scripts/generate-icons.mjs && yarn gen:index",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:build": "tsx scripts/buildTokens.ts",
    "tokens:check": "tsx scripts/buildTokens.ts --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@app/lint-config": "workspace:*",
    "@app/ts-config": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "^3.9.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
