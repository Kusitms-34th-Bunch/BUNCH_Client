{
  "extends": "@app/ts-config/vite.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"]
}
