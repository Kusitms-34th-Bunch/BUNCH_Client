{
  "expo": {
    "name": "Bunch",
    "slug": "mobile-shell",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "bunch-01",
          "project": "bunch-mobile"
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "사진함・게시물에 올리거나 프로필로 쓸 사진을 불러올 때 사용해요.",
          "cameraPermission": "사진을 찍어 사진함과 게시물에 올릴 때 사용해요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "사진함・게시물에 올리거나 프로필로 쓸 사진을 불러올 때 사용해요.",
          "savePhotosPermission": "사진함의 사진을 휴대폰 앨범에 저장할 때 사용해요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": { "networkInspector": false },
          "android": { "networkInspector": false }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191B1F",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1
        }
      ],
      "expo-apple-authentication"
    ],
    "ios": {
      "buildNumber": "1",
      "config": { "usesNonExemptEncryption": false },
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "kr.bunch.app",
      "appleTeamId": "9CGCR9499H",
      "associatedDomains": ["applinks:app.bunch.kr", "applinks:open.bunch.kr"],
      "infoPlist": {
        "CFBundleDisplayName": "BUNCH",
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": ["ko"],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#191B1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
