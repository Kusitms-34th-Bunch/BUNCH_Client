{
  "expo": {
    "name": "Bunch",
    "slug": "mobile-shell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "bunch-01",
          "project": "bunch-mobile"
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "사진함・게시물에 올리거나 프로필로 쓸 사진을 불러올 때 사용해요.",
          "cameraPermission": "사진을 찍어 사진함과 게시물에 올릴 때 사용해요.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Pretendard-Regular.otf"]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kyeongjooni.mobile-shell"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
