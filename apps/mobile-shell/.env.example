# WebView가 열 apps/web 주소. 실제 값은 .env.local에만 둔다.
#
# 배포 후: 배포된 URL을 그대로 쓴다.
#   EXPO_PUBLIC_WEB_URL=https://your-deployed-url.example.com
#
# 로컬 확인 (iOS 시뮬레이터): Mac과 네트워크를 공유해서 localhost가 그대로 된다.
#   EXPO_PUBLIC_WEB_URL=http://localhost:3000
#
# 로컬 확인 (실기기, 케이블/Expo Go): 같은 WiFi의 Mac LAN IP가 필요하다.
# `ipconfig getifaddr en0`로 확인한다. USB 연결은 설치 채널일 뿐 네트워크 트래픽은 WiFi로 나간다.
#   EXPO_PUBLIC_WEB_URL=http://<Mac LAN IP>:3000
EXPO_PUBLIC_WEB_URL=

# 네이티브 쉘 오류 수집. WebView 안의 웹 오류는 웹 프로젝트가 수집한다.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# 빌드 전용 비밀값. EXPO_PUBLIC_ 접두사를 붙이지 않는다.
SENTRY_AUTH_TOKEN=
