# 개발 실행은 DEV_WEB_URL, Release 빌드는 WEB_URL을 자동 선택한다.
# .env.local에 두 값을 설정해도 Release는 개발 주소를 사용하지 않는다.
# 시뮬레이터: http://localhost:3000 / 실제 iPhone: http://<PC LAN IP>:3000
EXPO_PUBLIC_DEV_WEB_URL=
# 운영 HTTPS 주소. 제출용 값은 .env.production.example도 참고한다.
EXPO_PUBLIC_WEB_URL=

# 네이티브 쉘 오류 수집. WebView 안의 웹 오류는 웹 프로젝트가 수집한다.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# EAS 빌드의 Sentry 환경 이름은 eas.json의 프로필에서 지정한다.
# 빌드 전용 비밀값. EXPO_PUBLIC_ 접두사를 붙이지 않는다.
# EAS에서는 Secret으로 등록한다.
SENTRY_AUTH_TOKEN=

# 카카오 로그인(네이티브 SDK). 카카오 개발자 콘솔의 네이티브 앱 키(앱 > 플랫폼 키)와 iOS 번들 ID 등록이 필요하다.
# 빌드할 때 app.config.js가 Info.plist에 쓰고 앱 실행 때 SDK를 시작하므로, 바꾸면 개발 앱을 다시 빌드한다.
# EAS 클라우드 빌드는 .env.local을 올리지 않으므로 EAS 환경변수에도 같은 이름으로 등록한다.
# 네이티브 앱 키만 넣는다(REST API 키·클라이언트 시크릿은 넣지 않는다, 앱 번들에 공개된다).
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
