# App Store 제출용 환경변수 양식. 실제 값은 커밋하지 않는다.
# 이 파일은 자동으로 적용되지 않는다. EAS 프로젝트의 production 환경에 등록한다.
# 운영 웹 주소 (필수). localhost나 개발 PC의 LAN IP를 사용하지 않는다.
EXPO_PUBLIC_WEB_URL=

# 네이티브 오류 수집을 사용하면 설정한다. 공개 값으로 앱에 포함된다.
EXPO_PUBLIC_SENTRY_DSN=
# eas.json의 production 프로필에도 설정되어 있다.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# 소스맵 업로드용 빌드 비밀값. EAS에서 Secret으로 등록한다.
# EXPO_PUBLIC_ 접두사를 붙이지 않는다.
SENTRY_AUTH_TOKEN=
