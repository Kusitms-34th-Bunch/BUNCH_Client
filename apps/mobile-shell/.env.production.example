# App Store 제출용 환경변수 양식. 실제 값은 커밋하지 않는다.
# 이 파일은 자동으로 적용되지 않는다. EAS 프로젝트의 production 환경에 등록한다.
# 운영 웹 주소 (필수). localhost나 개발 PC의 LAN IP를 사용하지 않는다.
EXPO_PUBLIC_WEB_URL=

# 카카오 로그인 네이티브 앱 키 (EAS 빌드에서 필수, 없으면 빌드가 멈춘다). 공개 값으로 앱에 포함된다.
# 네이티브 앱 키만 넣는다(REST API 키·클라이언트 시크릿은 넣지 않는다). 설명은 .env.example 참고.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# 구글 로그인 OAuth 클라이언트 ID (공개 값). iOS 유형은 EAS 빌드에서 필수이고(없으면 빌드가 멈춘다) 형식(…apps.googleusercontent.com)을 검사한다.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# 웹(서버) 유형. 백엔드가 허용하는 aud와 맞춘다(Android ID 토큰에 필요).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 네이티브 오류 수집을 사용하면 설정한다. 공개 값으로 앱에 포함된다.
EXPO_PUBLIC_SENTRY_DSN=
# eas.json의 production 프로필에도 설정되어 있다.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# 소스맵 업로드용 빌드 비밀값. EAS에서 Secret으로 등록한다.
# EXPO_PUBLIC_ 접두사를 붙이지 않는다.
SENTRY_AUTH_TOKEN=
