# Server-only: backend base URL called by the BFF (e.g. https://api.example.com). Never expose with NEXT_PUBLIC_.
API_BASE_URL=

# 개발 전용 토큰 로그인(서버 전용). `enabled`면 로그인 화면에 닉네임 입력이 보이고 /api/dev/token 이 동작한다(백엔드 POST /auth/dev/token 사용, 운영 빌드에서는 무시). 운영·미리보기 배포에서는 설정하지 않는다.
DEV_TOKEN_LOGIN=

# Public browser variables for the Next.js web app.
# Add only values that are safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# `enabled`로 빌드·실행하면 브라우저에서 MSW 가짜 서버가 API 요청에 응답한다(시연·개발용). 운영 배포에서는 설정하지 않는다.
NEXT_PUBLIC_API_MOCKING=
# PostHog 프로젝트 토큰(phc_..., 공개 키). 운영 빌드(가짜 서버 끔)에서 약관에 동의한 회원만 클릭 흐름을 수집한다(녹화 없음, ADR 018). 개발 서버에서는 넣어도 수집하지 않는다.
NEXT_PUBLIC_POSTHOG_KEY=
# 선택. 비우면 US(https://us.i.posthog.com), EU 프로젝트는 https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# Build-only credentials. Never use a NEXT_PUBLIC_ prefix for the auth token.
SENTRY_ORG=bunch-01
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=
