{
  "extends": "@app/ts-config/nextjs.json",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@domains/*": ["./src/domains/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "next.config.mjs",
    "sentry.*.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
