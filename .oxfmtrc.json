  "endOfLine": "lf",
  "printWidth": 100,
  "singleQuote": true,
  "sortTailwindcss": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".yarn/",
    ".pnp.*",
    ".turbo/",
    "dist/",
    "build/",
    ".next/",
    "coverage/",
    ".vitest/",
