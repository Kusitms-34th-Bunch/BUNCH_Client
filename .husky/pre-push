yarn typecheck

# 테스트는 develop 대비 바뀐 파일과 관련된 것만(전체는 CI가 실행). 기준 브랜치가 없으면 전체
base=origin/develop
if ! git rev-parse --verify --quiet "$base" >/dev/null; then
  yarn test
  exit $?
fi
for workspace in @app/web @app/admin @app/design-system @app/api-core; do
  yarn workspace "$workspace" vitest run --changed "$base" --passWithNoTests || exit 1
done
